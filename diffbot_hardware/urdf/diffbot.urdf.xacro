<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffbot">

  <!-- ════════════════════════════════════════════════════════════════════════
       Robot parameters — edit these to match your physical robot
       ════════════════════════════════════════════════════════════════════════ -->
  <xacro:property name="wheel_radius"      value="0.033"/>   <!-- metres -->
  <xacro:property name="wheel_width"       value="0.020"/>   <!-- metres -->
  <xacro:property name="wheel_separation"  value="0.160"/>   <!-- centre to centre, metres -->
  <xacro:property name="base_length"       value="0.200"/>
  <xacro:property name="base_width"        value="0.150"/>
  <xacro:property name="base_height"       value="0.050"/>
  <xacro:property name="base_mass"         value="1.5"/>     <!-- kg -->
  <xacro:property name="wheel_mass"        value="0.1"/>

  <!-- ════════════════════════════════════════════════════════════════════════
       Inertia macros
       ════════════════════════════════════════════════════════════════════════ -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m/12*(w*w+h*h)}" ixy="0" ixz="0"
        iyy="${m/12*(l*l+h*h)}" iyz="0"
        izz="${m/12*(l*l+w*w)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m/12*(3*r*r+h*h)}" ixy="0" ixz="0"
        iyy="${m/12*(3*r*r+h*h)}" iyz="0"
        izz="${m/2*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- ════════════════════════════════════════════════════════════════════════
       Materials
       ════════════════════════════════════════════════════════════════════════ -->
  <material name="dark_grey">  <color rgba="0.2 0.2 0.2 1.0"/> </material>
  <material name="light_grey"> <color rgba="0.6 0.6 0.6 1.0"/> </material>
  <material name="blue">       <color rgba="0.0 0.4 0.8 1.0"/> </material>

  <!-- ════════════════════════════════════════════════════════════════════════
       Links
       ════════════════════════════════════════════════════════════════════════ -->

  <!-- base_footprint: projection of base_link on the ground -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- base_link: geometric centre of the chassis -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" l="${base_length}" w="${base_width}" h="${base_height}"/>
  </link>

  <!-- Left wheel -->
  <link name="left_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
  </link>

  <!-- Right wheel -->
  <link name="right_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
  </link>

  <!-- Caster wheel (passive, no joint actuated) -->
  <link name="caster_wheel_link">
    <visual>
      <geometry><sphere radius="${wheel_radius/2}"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <geometry><sphere radius="${wheel_radius/2}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000025"/>
    </inertial>
  </link>


  <!-- ════════════════════════════════════════════════════════════════════════
       Joints
       ════════════════════════════════════════════════════════════════════════ -->

  <!-- Left wheel: rotates about the Y-axis of the joint frame.
       The joint origin is rotated -90° in roll so the cylinder's Z-axis
       (its spin axis) aligns with the global Y-axis. -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="left_wheel_link"/>
    <origin xyz="0 ${wheel_separation/2} 0" rpy="-${pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <!-- Right wheel: mirror of left (roll +90°) -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="right_wheel_link"/>
    <origin xyz="0 -${wheel_separation/2} 0" rpy="${pi/2} 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01" friction="0.1"/>
  </joint>

  <!-- Caster (fixed ball joint — modelled as continuous with no limits) -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_wheel_link"/>
    <origin xyz="-${base_length/2 - wheel_radius/2} 0 -${wheel_radius/2}" rpy="0 0 0"/>
  </joint>


  <!-- ════════════════════════════════════════════════════════════════════════
       ros2_control block
       ════════════════════════════════════════════════════════════════════════ -->
  <ros2_control name="DiffBotHardware" type="system">
    <hardware>
      <plugin>diffbot_hardware/DiffBotHardware</plugin>

      <!-- Serial port configuration -->
      <param name="serial_port">/dev/ttyACM0</param>
      <!-- Use /dev/esp32_diffbot if you set up the udev rule in the README -->
      <param name="baud_rate">115200</param>

      <!-- Mechanical parameters (must match ticks_per_rev_ on the ESP32) -->
      <param name="wheel_radius">0.033</param>
      <param name="wheel_separation">0.160</param>
      <!--
        ticks_per_rev = encoder_cpr × gear_ratio × quadrature_multiplier
        Example: 11 CPR encoder × 34.02 gear ratio × 4 (quadrature) ≈ 1497
        Adjust this to your specific encoder + motor combination.
      -->
      <param name="ticks_per_rev">1440</param>

      <!-- Maximum wheel velocity clamp sent to the ESP32 (rad/s) -->
      <param name="max_speed_rad_s">10.0</param>

      <!-- Timeout (ms) for serial readline — keep well below 1/update_rate -->
      <param name="read_timeout_ms">5</param>

      <!-- FIX #11: Velocity low-pass filter coefficient (0.0–1.0).
           α = 1.0 → no filtering.  α = 0.1 → heavy smoothing.
           Tune down if diff_drive_controller oscillates at low speed. -->
      <param name="vel_filter_alpha">0.3</param>
    </hardware>

    <!-- Joint 0: left wheel — velocity command, position + velocity state -->
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max"> 10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Joint 1: right wheel — velocity command, position + velocity state -->
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10.0</param>
        <param name="max"> 10.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</robot>
